<!--
  Expedition board (stands on the lectern stone at the start): a calm welcome, Enter VR, and a More toggle that opens the comfort / sound / developer rows.
  Panel, Button, ButtonIcon, ButtonLabel come from the bundled Horizon kit.
  Sizes are plain px; the scene node scales the whole panel into metres.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 460px;
  }
  .panel-content {
    flex-direction: column;
    gap: 6px;
    padding-top: 22px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 12px;
  }
  .eyebrow {
    color: #f0c869;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.6px;
  }
  .heading {
    color: #f6f3e8;
    font-size: 34px;
    font-weight: 700;
    line-height: 40px;
  }
  .body {
    color: #d9dccf;
    font-size: 20px;
    line-height: 27px;
  }
  .more {
    flex-direction: column;
  }
  .status {
    color: #8fd9b5;
    font-size: 16px;
    line-height: 22px;
    margin-top: 6px;
  }
  .row {
    flex-direction: row;
    gap: 8px;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 10px;
  }
  .button {
    justify-content: flex-start;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 10px;
  }
  .chip {
    flex-grow: 1;
  }
  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">JUMANJI VR</div>
    <div class="heading">The overlook</div>
    <div class="body">Left stick walks. Right stick turns.</div>
    <div class="body">Hold grip near an object to pick it up.</div>
    <div class="body">A trail leads down to the ancient clearing.</div>
    <div id="status" class="status">Checking for VR...</div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter VR</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to browser</ButtonLabel>
  </Button>
  <div class="row">
    <Button id="more-button" class="chip">
      <ButtonLabel id="more-label">More options</ButtonLabel>
    </Button>
  </div>
  <div id="more-section" class="more" style="display: none">
  <div class="row">
    <Button id="turn-button" class="chip">
      <ButtonLabel id="turn-label">Snap turn 30 deg</ButtonLabel>
    </Button>
    <Button id="quality-button" class="chip">
      <ButtonLabel id="quality-label">Quality high</ButtonLabel>
    </Button>
  </div>
  <div class="row">
    <Button id="perf-button" class="chip">
      <ButtonLabel id="perf-label">Diagnostics off</ButtonLabel>
    </Button>
    <Button id="copy-button" class="chip">
      <ButtonLabel id="copy-label">Copy results</ButtonLabel>
    </Button>
  </div>
  <div class="row">
    <Button id="test-entrance-button" class="chip">
      <ButtonLabel>Test: entrance</ButtonLabel>
    </Button>
    <Button id="test-trail-button" class="chip">
      <ButtonLabel>trail</ButtonLabel>
    </Button>
    <Button id="test-clearing-button" class="chip">
      <ButtonLabel>clearing</ButtonLabel>
    </Button>
  </div>
  <div class="row">
    <Button id="move-button" class="chip">
      <ButtonLabel id="move-label">Move by head</ButtonLabel>
    </Button>
    <Button id="reduced-button" class="chip">
      <ButtonLabel id="reduced-label">Reduced motion off</ButtonLabel>
    </Button>
    <Button id="seated-button" class="chip">
      <ButtonLabel id="seated-label">Standing</ButtonLabel>
    </Button>
  </div>
  <div class="row">
    <Button id="speed-button" class="chip">
      <ButtonLabel id="speed-label">Speed 2.5 m/s</ButtonLabel>
    </Button>
    <Button id="vignette-button" class="chip">
      <ButtonLabel id="vignette-label">Vignette 50%</ButtonLabel>
    </Button>
    <Button id="hazard-button" class="chip">
      <ButtonLabel id="hazard-label">Auto-slow on</ButtonLabel>
    </Button>
  </div>
  <div class="row">
    <Button id="sound-button" class="chip">
      <ButtonLabel id="sound-label">Sound on</ButtonLabel>
    </Button>
    <Button id="wildlife-button" class="chip">
      <ButtonLabel id="wildlife-label">Wildlife on</ButtonLabel>
    </Button>
  </div>
  </div>
</Panel>
