{
  "name": "jumanji-vr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "scene:generate": "node tools/generate-scene.mjs",
    "stats": "node tools/asset-stats.mjs",
    "validate": "node tools/validate-scene.mjs",
    "stats:check": "node tools/asset-stats.mjs --check",
    "verify": "npm run typecheck && npm run validate && npm run stats:check && npm run lod && npm run wildlife && npm run build",
    "perf:probe": "node tools/perf-probe.mjs",
    "audit": "node tools/audit.mjs",
    "wildlife": "node tools/wildlife-test.mjs",
    "wildlife:browser": "node tools/wildlife-test.mjs --only none --browser",
    "lod": "node tools/lod-gaps.mjs && node tools/lod-gaps.mjs --low"
  },
  "dependencies": {
    "@iwsdk/core": "1.1.0-rc.2",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.185.0"
  },
  "devDependencies": {
    "@iwsdk/reference": "1.1.0-rc.2",
    "@iwsdk/cli": "1.1.0-rc.2",
    "@iwsdk/vite-plugin-dev": "1.1.0-rc.2",
    "@meta-quest/metavr": "^1.8.1",
    "@types/three": "^0.185.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.185.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
